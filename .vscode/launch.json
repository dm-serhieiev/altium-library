{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "InvenTree Sync: Inspect",
            "type": "debugpy",
            "request": "launch",
            "module": "inventree_sync",
            "args": [
                "inspect",
                "--config",
                "${workspaceFolder}/tools/inventree-sync/config.toml"
            ],
            "cwd": "${workspaceFolder}/tools/inventree-sync",
            "envFile": "${workspaceFolder}/tools/inventree-sync/.env",
            "console": "integratedTerminal",
            "justMyCode": true
        }
    ]
}