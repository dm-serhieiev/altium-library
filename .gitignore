# ============================================================
# Altium Designer
# ============================================================

# Backups / history
History/
**/History/
__Previews/
**/__Previews/

# Temporary and backup files
*.SchLib.~*
*.PcbLib.~*
*.SchDoc.~*
*.PcbDoc.~*
*.PrjPcb.~*
*.DsnWrk.~*

# Generated project structure
*.PrjPcbStructure

# Logs and reports
*.LOG
*.log
*.REP
*.ERR

# Preview files
*.SchDocPreview
*.PcbDocPreview

# Altium workspace files
*.DsnWrk


# ============================================================
# Python
# ============================================================

__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/
env/

# Build / package artifacts
build/
dist/
*.egg-info/

# Test / analysis caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/


# ============================================================
# InvenTree sync configuration / credentials
# ============================================================

.env
.env.*
!.env.example

config.toml
config.local.toml

# Generated SQLite snapshots in the repository output directory
/database/*.[sS][qQ][lL][iI][tT][eE]
/database/*.[sS][qQ][lL][iI][tT][eE]-journal
/database/*.[sS][qQ][lL][iI][tT][eE]-wal
/database/*.[sS][qQ][lL][iI][tT][eE]-shm
/database/*.[sS][qQ][lL][iI][tT][eE]3
/database/*.[sS][qQ][lL][iI][tT][eE]3-journal
/database/*.[sS][qQ][lL][iI][tT][eE]3-wal
/database/*.[sS][qQ][lL][iI][tT][eE]3-shm
# Unique staging files and destination locks owned by inventree-sync
*.staging.sqlite
*.staging.sqlite-journal
*.sync.lock

# Tokens / secrets
*.token
*.secret


# ============================================================
# Excel
# ============================================================

# Microsoft Office temporary lock files
~$*.xlsx
~$*.xls
~$*.docx

# ============================================================
# General temporary files
# ============================================================

*.tmp
*.temp
*.bak
*.cache
