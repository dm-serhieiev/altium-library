# ============================================================
# Altium Designer
# ============================================================

# Backups / history
History/
**/History/
__Previews/
**/__Previews/

# Temporary and backup files
*.SchLib.~*
*.PcbLib.~*
*.SchDoc.~*
*.PcbDoc.~*
*.PrjPcb.~*
*.DsnWrk.~*

# Generated project structure
*.PrjPcbStructure

# Logs and reports
*.LOG
*.log
*.REP
*.ERR

# Preview files
*.SchDocPreview
*.PcbDocPreview

# Altium workspace files
*.DsnWrk


# ============================================================
# Python
# ============================================================

__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv*/
venv/
env/

# Build / package artifacts
build/
dist/
*.egg-info/

# Test / analysis caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/


# ============================================================
# InvenTree sync configuration / credentials
# ============================================================

.env
.env.*
!.env.example

config.toml
config.local.toml

# Generated SQLite output; one intentional offline snapshot is versioned.
*.[sS][qQ][lL][iI][tT][eE]
*.[sS][qQ][lL][iI][tT][eE]3
!/database/components.sqlite
*.[sS][qQ][lL][iI][tT][eE]-journal
*.[sS][qQ][lL][iI][tT][eE]-wal
*.[sS][qQ][lL][iI][tT][eE]-shm
*.[sS][qQ][lL][iI][tT][eE]3-journal
*.[sS][qQ][lL][iI][tT][eE]3-wal
*.[sS][qQ][lL][iI][tT][eE]3-shm
*.sync.lock

# Only the two verified Windows applications are intentionally versioned.
*.exe
!/tools/inventree-sync.exe
!/tools/setup-odbc.exe

# Tokens / secrets
*.token
*.secret


# ============================================================
# Excel
# ============================================================

# Microsoft Office temporary lock files
~$*.xlsx
~$*.xls
~$*.docx

